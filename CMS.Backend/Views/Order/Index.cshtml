@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";

}

<h2 class="text-primary">📦 DANH SÁCH ĐƠN HÀNG</h2>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Ngày đặt</th>
            <th>Khách hàng</th>
            <th>Email</th>
            <th>Trạng thái</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(item.Customer?.FullName ?? "Không có")</td>
                <td>@(item.Customer?.Email ?? "Không có")</td>
                <td>
                    @if (item.Status == 0)
                    {
                        <span class="badge bg-warning">⏳ Chờ duyệt</span>
                    }
                    else if (item.Status == 1)
                    {
                        <span class="badge bg-info">🚚 Đang giao</span>
                    }
                    else if (item.Status == 2)
                    {
                        <span class="badge bg-success">✅ Đã xong</span>
                    }
                </td>
                <td>@(item.Notes ?? "Không có")</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <p class="text-muted">
        📊 Tổng số đơn hàng: <strong>@Model.Count()</strong>
    </p>
</div>