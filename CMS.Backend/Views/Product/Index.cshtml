@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";

}

<h2 class="text-primary">📦 DANH SÁCH SẢN PHẨM</h2>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên sản phẩm</th>
            <th>Mô tả</th>
            <th>Giá</th>
            <th>Số lượng</th>
            <th>Danh mục</th>
            <th>Hình ảnh</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@(item.Description ?? "Chưa có mô tả")</td>
                <td>@item.Price.ToString("N0") VNĐ</td>
                <td>@item.StockQuantity</td>
                <td>@(item.CategoryProduct?.Name ?? "Chưa có danh mục")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" />
                    }
                    else
                    {
                        <span>Không có ảnh</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <p class="text-muted">
        📊 Tổng số sản phẩm: <strong>@Model.Count()</strong>
    </p>
</div>