@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4">

    ```
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">📦 DANH SÁCH SẢN PHẨM</h2>

        <a asp-action="Create" class="btn btn-success">
            ➕ Thêm sản phẩm
        </a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Mô tả</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Danh mục</th>
                <th width="180">Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Id</td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="/uploads/@item.ImageUrl"
                                 alt="@item.Name"
                                 width="80"
                                 height="80"
                                 style="object-fit:cover;border-radius:8px;" />
                        }
                        else
                        {
                            <span class="text-muted">Không có ảnh</span>
                        }
                </td>

                <td>@item.Name</td>

                <td>
                    @(string.IsNullOrEmpty(item.Description)
                                        ? "Chưa có mô tả"
                                        : item.Description)
                </td>

                    <td class="text-danger fw-bold">
                        @item.Price.ToString("N0") VNĐ
                    </td>

                    <td>
                        @item.StockQuantity
                    </td>

                    <td>
                        @(item.CategoryProduct?.Name ?? "Chưa có danh mục")
                    </td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            ✏️ Sửa
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                🗑️ Xóa
                            </button>

                        </form>
                    </td>

                </tr>
                        }
        </tbody>
    </table>

    <div class="mt-3">
        <p class="text-muted">
            📊 Tổng số sản phẩm:
            <strong>@Model.Count()</strong>
        </p>
    </div>
    ```

</div>
