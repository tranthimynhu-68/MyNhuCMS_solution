@model IEnumerable<CMS.Data.Entities.Customer>

@{
    ViewData["Title"] = "Danh sách khách hàng";
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";

}

<h2 class="text-primary">👥 DANH SÁCH KHÁCH HÀNG</h2>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Số điện thoại</th>
            <th>Địa chỉ</th>
            <th>Mật khẩu</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@(item.Phone ?? "Chưa có")</td>
                <td>@(item.Address ?? "Chưa có")</td>
                <td>@item.Password</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <p class="text-muted">
        📊 Tổng số khách hàng: <strong>@Model.Count()</strong>
    </p>
</div>