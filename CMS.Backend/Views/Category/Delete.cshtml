@model CMS.Data.Entities.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="container mt-4">
    <h2 class="text-danger">🗑️ XÓA DANH MỤC</h2>
    <hr />

    <div class="alert alert-danger">
        ⚠️ Bạn có chắc chắn muốn xóa danh mục <strong>@Model.Name</strong> không?
    </div>

    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Tên danh mục</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Mô tả</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">🗑️ Xác nhận xóa</button>
            <a href="/Category/Index" class="btn btn-secondary">❌ Hủy bỏ</a>
        </div>
    </form>
</div>