@model CMS.Data.Entities.Category

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<h2>📁 CHI TIẾT DANH MỤC</h2>
<hr />

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2">ID</dt>
            <dd class="col-sm-10">@Model.Id</dd>

            <dt class="col-sm-2">Tên danh mục</dt>
            <dd class="col-sm-10">@Model.Name</dd>

            <dt class="col-sm-2">Mô tả</dt>
            <dd class="col-sm-10">@Model.Description</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a href="/Category/Edit/@Model.Id" class="btn btn-warning">✏️ Sửa</a>
    <a href="/Category/Delete/@Model.Id" class="btn btn-danger">🗑️ Xóa</a>
    <a href="/Category/Index" class="btn btn-secondary">↩️ Quay lại</a>
</div>