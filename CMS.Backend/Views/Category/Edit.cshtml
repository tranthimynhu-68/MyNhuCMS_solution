@model CMS.Data.Entities.Category

@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="container mt-4">
    <h2 class="text-primary">✏️ SỬA DANH MỤC</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên danh mục:</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả:</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">💾 Cập nhật</button>
                    <a href="/Category/Index" class="btn btn-secondary">❌ Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
</div>