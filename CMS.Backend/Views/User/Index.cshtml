@model IEnumerable<CMS.Data.Entities.User>
@{
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Danh sách người dùng";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">
            <i class="bi bi-people"></i> DANH SÁCH NGƯỜI DÙNG
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm người dùng mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            ⚠️ Chưa có người dùng nào. Hãy thêm mới!
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ tên</th>
                    <th>Vai trò</th>
                    <th>Mật khẩu</th>
                    <th style="width: 180px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Username</td>
                        <td>@item.FullName</td>
                        <td>
                            @if (item.Role == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else if (item.Role == "Editor")
                            {
                                <span class="badge bg-warning text-dark">Editor</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Role</span>
                            }
                        </td>
                        <td>@item.PasswordHash</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa người dùng @item.Username không?')">
                                <i class="bi bi-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>