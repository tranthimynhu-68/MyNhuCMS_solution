@model IEnumerable<CMS.Data.Entities.OrderDetail>

@{
    ViewData["Title"] = "Danh sách chi tiết đơn hàng";
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";

}

<h2 class="text-primary">📋 DANH SÁCH CHI TIẾT ĐƠN HÀNG</h2>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Mã đơn hàng</th>
            <th>Tên sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.OrderId</td>
                <td>@(item.Product?.Name ?? "Không có")</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                <td>@((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <p class="text-muted">
        📊 Tổng số chi tiết đơn hàng: <strong>@Model.Count()</strong>
    </p>
</div>