@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Trang chủ";
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .card {
            transition: transform 0.3s ease;
            border: none;
            border-radius: 10px;
            overflow: hidden;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .card-img-top {
            height: 200px;
            object-fit: cover;
        }

        .badge {
            font-size: 12px;
            font-weight: 500;
        }

        .card-title {
            font-size: 18px;
            font-weight: 600;
        }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: white;
        }

        .footer-card {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-center mb-4 text-danger">
            <i class="bi bi-newspaper"></i> TIN TỨC MỚI NHẤT
        </h2>

        @if (!Model.Any())
        {
            <div class="alert alert-warning text-center">
                ⚠️ Chưa có bài viết nào. Hãy thêm bài viết mới!
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm h-100">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title">
                            }
                            else
                            {
                                <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center">
                                    <span class="text-white">📷 Chưa có ảnh</span>
                                </div>
                            }

                            <div class="card-body">
                                <span class="badge bg-primary mb-2">
                                    @(item.Category?.Name ?? "Chưa phân loại")
                                </span>
                                <h5 class="card-title">@item.Title</h5>
                                <p class="card-text text-truncate">@item.Content</p>
                                <a href="/Post/Details/@item.Id" class="btn btn-outline-danger btn-sm">
                                    📖 Đọc tiếp
                                </a>
                            </div>
                            <div class="card-footer footer-card text-muted small">
                                📅 @item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</body>
</html>