@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Xóa bài viết";
}

<div class="container mt-4">
    <h2>🗑️ XÓA BÀI VIẾT</h2>
    <hr />

    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i>
        Bạn có chắc chắn muốn xóa bài viết này? Hành động này không thể hoàn tác!
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@Model.Title</h5>
            <p class="card-text">
                <strong>Danh mục:</strong> @(Model.Category?.Name ?? "Chưa có")<br />
                <strong>Ngày đăng:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
            </p>
            <p class="card-text">@(Model.Content?.Length > 200 ? Model.Content.Substring(0, 200) + "..." : Model.Content)</p>
        </div>
    </div>

    <div class="mt-3">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">🗑️ Xác nhận xóa</button>
            <a href="/Post/Index" class="btn btn-secondary">↩️ Quay lại</a>
        </form>
    </div>
</div>