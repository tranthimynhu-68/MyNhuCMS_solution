@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = Model.Title;
}

<!-- Sinh viên: Trần Thị Mỹ Như -->
<!-- MSSV: 2123110054 -->
<!-- Ngày hoàn thành: 21/05/2026 -->

<div class="container mt-5">
    <!-- Breadcrumb navigation -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/Post/Index" class="text-decoration-none">
                    <i class="bi bi-house"></i> Trang chủ
                </a>
            </li>
            @if (Model.Category != null)
            {
                <li class="breadcrumb-item">
                    <a href="/Post/Index/@Model.CategoryId" class="text-decoration-none">
                        @Model.Category.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <!-- Tiêu đề -->
            <h1 class="display-5 fw-bold text-primary">@Model.Title</h1>

            <!-- Thông tin meta -->
            <div class="d-flex justify-content-between align-items-center mt-3 mb-3 flex-wrap gap-2">
                <p class="text-muted mb-0">
                    <i class="bi bi-calendar3"></i> Đăng ngày:
                    @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                </p>

                @if (Model.Category != null)
                {
                    <span class="badge bg-info fs-6 px-3 py-2">
                        <i class="bi bi-folder"></i> @Model.Category.Name
                    </span>
                }
            </div>

            <hr />

            <!-- Hình ảnh -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="text-center mb-4">
                    <img src="@Model.ImageUrl"
                         class="img-fluid rounded shadow"
                         alt="@Model.Title"
                         style="max-height: 500px; width: 100%; object-fit: cover;">
                </div>
            }
            else
            {
                <div class="text-center mb-4 bg-secondary bg-opacity-10 rounded p-5">
                    <i class="bi bi-image fs-1 text-muted"></i>
                    <p class="text-muted mt-2">Chưa có ảnh đại diện</p>
                </div>
            }

            <!-- Nội dung bài viết -->
            <div class="post-content fs-5 mt-4" style="line-height: 1.8;">
                @Html.Raw(Model.Content?.Replace("\n", "<br/>"))
            </div>

            <!-- Nút điều hướng -->
            <div class="mt-5 pt-3 border-top d-flex justify-content-between flex-wrap gap-2">
                <a href="javascript:history.back()" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>

                <div class="d-flex gap-2">
                    @if (Model.Category != null)
                    {
                        <a href="/Post/Index/@Model.CategoryId" class="btn btn-info text-white">
                            <i class="bi bi-folder"></i> Xem thêm trong @Model.Category.Name
                        </a>
                    }
                    <a href="/Post/Index" class="btn btn-primary">
                        <i class="bi bi-newspaper"></i> Tất cả bài viết
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CSS cho nội dung -->
<style>
    .post-content {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .post-content p {
            margin-bottom: 1.2rem;
        }

        .post-content h1, .post-content h2, .post-content h3 {
            margin-top: 1.5rem;
            margin-bottom: 1rem;
        }

        .post-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin: 1rem 0;
        }

    .breadcrumb a:hover {
        color: #0d6efd !important;
        text-decoration: underline !important;
    }
</style>