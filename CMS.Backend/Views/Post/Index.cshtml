@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
        Layout = "/Views/Shared/_LayoutAdmin.cshtml";

}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📰 DANH SÁCH BÀI VIẾT</h2>
        <a href="/Post/Create" class="btn btn-success">
            + Thêm bài viết mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">Chưa có bài viết nào.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                <span class="text-muted">📷 No Image</span>
                            </div>
                        }

                        <div class="card-body">
                            <span class="badge bg-info text-dark mb-2">@(item.Category?.Name ?? "Chưa có danh mục")</span>
                            <h5 class="card-title fw-bold">@item.Title</h5>
                            <p class="card-text text-muted">
                                @if (item.Content?.Length > 80)
                                {
                                    @(item.Content.Substring(0, 80) + "...")
                                }
                                else
                                {
                                    @item.Content
                                }
                            </p>
                            <p class="text-muted small mb-3">
                                📅 @item.CreatedDate.ToString("dd/MM/yyyy")
                            </p>

                            <!-- Nút hành động -->
                            <div class="d-flex gap-2">
                                <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                                <a href="/Post/Edit/@item.Id" class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a href="/Post/Delete/@item.Id" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>